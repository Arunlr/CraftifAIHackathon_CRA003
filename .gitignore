# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large media files (> 100MB)
*.mp4
*.webm
*.avi
*.mkv
media/*.mp4
!media/.gitkeep

# TensorRT engine binaries (re-generated by PipeGen / TensorRT)
*.engine
*.plan

# Build directories
build/
dist/
.vscode/
.idea/
*.log

# Keep evidence folder and artifacts intact
!evidence/*.png
!evidence/*.txt
